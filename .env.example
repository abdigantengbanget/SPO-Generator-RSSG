# GEMINI_API_KEY: Primary AI key for Gemini API calls.
# Users configure this via .env locally or Vercel / AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Secondary/fallback AI key (https://openrouter.ai/keys).
# Used automatically if GEMINI_API_KEY is missing, invalid, or hits rate/quota limits (429).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Optional OpenRouter model slug (defaults to "openrouter/free").
OPENROUTER_MODEL="openrouter/free"

# APP_URL: The URL where this applet is hosted.
# Used for HTTP-Referer header on OpenRouter and self-referential links.
APP_URL="MY_APP_URL"
